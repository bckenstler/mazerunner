.env
.venv/
datasets/*/test-hidden/
# QC contact sheets render the tasks they sample, so a hidden-split sheet leaks
# hidden mazes even though it lives outside the split directory.
datasets/*/qc-test-hidden*.png
__pycache__/
*.pyc
# Exclude run output, but keep written findings — they are documents, not data.
# Must match contents (results/*) rather than the directory (results/): git
# will not re-include anything beneath an excluded directory.
results/*
!results/*.md
!results/*.txt
!results/figures/
!results/failure-modes.jsonl
# ...but not the hidden-split build log: it names hidden task ids alongside
# their topology seeds, and generation is deterministic, so publishing it
# would let anyone rebuild the held-out mazes.
results/dataset-build-hidden-log.txt
.pytest_cache/
# The archive stays local; full traces ship as GitHub Release assets.
archive/
litellm.config.json
results/promo-frames/
release-assets/
.release-scrub.json
